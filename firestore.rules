rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.super_admin == true ||
        request.auth.token.email == 'ptspmanhst@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Schools collection
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin() && isValidId(schoolId);

      match /{document=**} {
        allow read: if isSignedIn();
        // Allow write only if user is super-admin OR belongs to this school
        allow write: if isSuperAdmin() || (isSignedIn() && request.auth.token.schoolId == schoolId);
      }
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn(); // Allow for all authenticated users to manage user documents
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false;
    }

    // Test connection
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
